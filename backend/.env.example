# Copy to backend/.env for local runs (it's git-ignored). All variables are optional locally.
# On Cloud Run the same names are set as the service's environment variables instead.

# Defaults to the docker-compose database. For Neon, paste its connection string
# (postgresql://...?sslmode=require); the driver prefix is added automatically.
FPLAI_DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl

# Allowed frontend origins (JSON list). In production: your Cloudflare Pages address.
FPLAI_CORS_ORIGINS=["http://localhost:5173"]

# Your own language model for the "Why" explanations, served by Ollama on this machine.
# Leave it out (as the hosted site does) and explanations come from the templates.
# FPLAI_LOCAL_MODEL=llama3.2:3b
# FPLAI_OLLAMA_URL=http://localhost:11434
