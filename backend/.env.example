# Copy to backend/.env to override defaults. All variables are optional locally.

# Defaults to the docker-compose database. For Neon, paste its connection string
# (postgresql://...?sslmode=require); the driver prefix is added automatically.
FPLAI_DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5432/fpl

# Allowed frontend origins (JSON list).
FPLAI_CORS_ORIGINS=["http://localhost:5173"]
